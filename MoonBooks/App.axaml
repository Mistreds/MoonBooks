<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MoonBooks.App"
             xmlns:local="using:MoonBooks"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#F5F2EC" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFEFC" />
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#ECE8E0" />
        <SolidColorBrush x:Key="InkBrush" Color="#242722" />
        <SolidColorBrush x:Key="MutedInkBrush" Color="#74776F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#344F3D" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#DDE8DF" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#E4E0D8" />
        <SolidColorBrush x:Key="WarmBrush" Color="#C77745" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>

        <Style Selector="Button">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="18,11" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#42654D" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style Selector="Button.chip">
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="Button.bookCard">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.bookCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="TextBox.search">
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Application.Styles>
</Application>