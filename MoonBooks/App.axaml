<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MoonBooks.App"
             xmlns:local="using:MoonBooks"
             RequestedThemeVariant="Light">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MoonBooks/Styles/Tokens.axaml" />
                <ResourceInclude Source="avares://MoonBooks/Styles/ReaderThemes.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://MoonBooks/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
