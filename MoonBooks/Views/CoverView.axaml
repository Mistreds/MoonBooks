<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MoonBooks.ViewModels"
             x:Class="MoonBooks.Views.CoverView"
             x:DataType="vm:BookCardViewModel"
             Width="148">
    <Grid Height="210">
        <Border CornerRadius="8" ClipToBounds="True" IsVisible="{Binding HasCover}">
            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
        </Border>
        <Border CornerRadius="8" Background="{Binding PlaceholderBrush}" Padding="12" IsVisible="{Binding !HasCover}">
            <StackPanel VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="4" />
                <TextBlock Text="{Binding Author}" Foreground="White" Opacity="0.8" FontSize="12" TextWrapping="Wrap" MaxLines="2" />
            </StackPanel>
        </Border>
        <Border IsVisible="{Binding IsMissing}" Background="#AA242722" CornerRadius="8">
            <TextBlock Text="Нет файла" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
