<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MoonBooks.ViewModels"
             xmlns:model="using:MoonBooks.Models"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="852"
             x:Class="MoonBooks.Views.LibraryView"
             x:Name="Root"
             x:DataType="vm:MainViewModel"
             x:CompileBindings="False">

    <Grid ColumnDefinitions="244,*">
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="18,22">
                <StackPanel Spacing="5" Margin="8,0,8,24">
                    <TextBlock Text="Моя библиотека" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="8 книг · 3 читаются сейчас"
                               Foreground="{DynamicResource MutedInkBrush}" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="5">
                    <TextBlock Text="ПОЛКИ" Margin="14,0,0,8" FontSize="10" FontWeight="Bold"
                               LetterSpacing="1.4" Foreground="{DynamicResource MutedInkBrush}" />
                    <ItemsControl ItemsSource="{Binding Shelves}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:ShelfItem">
                                <Button Classes="nav"
                                        Command="{Binding DataContext.SelectShelfCommand, ElementName=Root}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Name}" />
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceMutedBrush}"
                                                CornerRadius="10" Padding="7,2">
                                            <TextBlock Text="{Binding Count}" FontSize="11"
                                                       Foreground="{DynamicResource MutedInkBrush}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="12,16" />

                    <Button Classes="nav">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="＋" FontSize="18" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Новая полка" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="⚙" FontSize="16" Foreground="{DynamicResource MutedInkBrush}" />
                            <TextBlock Text="Настройки" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="2" Background="{DynamicResource AccentSoftBrush}"
                        CornerRadius="16" Padding="14">
                    <Grid ColumnDefinitions="36,*" RowDefinitions="Auto,Auto">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="{Binding SyncGlyph}" Foreground="White" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding SyncTitle}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SyncSubtitle}" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedInkBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Row="1" Grid.ColumnSpan="2" Classes="primary"
                                Margin="0,12,0,0" Padding="10,8"
                                Command="{Binding SyncCommand}" Content="Синхронизировать" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1">
            <StackPanel Margin="44,34,44,52" Spacing="34">
                <Grid ColumnDefinitions="*,360">
                    <StackPanel>
                        <TextBlock Text="Добрый вечер" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarmBrush}" />
                        <TextBlock Text="Что будем читать?" FontSize="34" FontWeight="SemiBold"
                                   LetterSpacing="-0.8" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Classes="search"
                             PlaceholderText="Поиск по названию, автору или жанру"
                             Text="{Binding SearchText, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Spacing="15">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Продолжить чтение" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="Вернитесь туда, где остановились"
                                       Foreground="{DynamicResource MutedInkBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Смотреть все  →" Foreground="{DynamicResource AccentBrush}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ContinueReading}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:BookItem">
                                <Button Classes="bookCard" Margin="0,0,14,0"
                                        Command="{Binding DataContext.OpenBookCommand, ElementName=Root}"
                                        CommandParameter="{Binding}">
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="18"
                                            Padding="13" BorderBrush="{DynamicResource HairlineBrush}"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="84,*" ColumnSpacing="15">
                                            <Border Width="84" Height="118" CornerRadius="10"
                                                    Background="{Binding CoverStart}" ClipToBounds="True">
                                                <Grid>
                                                    <Border Width="70" Height="120" Background="{Binding CoverEnd}"
                                                            Opacity=".34" HorizontalAlignment="Right"
                                                            RenderTransform="rotate(24deg)" />
                                                    <TextBlock Text="{Binding CoverMark}" Foreground="White"
                                                               FontFamily="Georgia" FontSize="34" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
                                                <Border HorizontalAlignment="Left" Background="{DynamicResource SurfaceMutedBrush}"
                                                        CornerRadius="8" Padding="7,3">
                                                    <TextBlock Text="{Binding Format}" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               FontSize="15" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Author}" FontSize="11" Margin="0,3,0,0"
                                                               Foreground="{DynamicResource MutedInkBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="3" Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding ProgressLabel}" FontSize="10"
                                                                   Foreground="{DynamicResource MutedInkBrush}" />
                                                        <TextBlock Grid.Column="1" Text="›" FontSize="18"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Grid>
                                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}"
                                                                 Height="4" Foreground="{DynamicResource AccentBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedShelf}" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="Ваша коллекция в одном месте"
                                       Foreground="{DynamicResource MutedInkBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                            <Button Classes="icon" Content="▦" />
                            <Button Classes="icon" Content="☰" Foreground="{DynamicResource MutedInkBrush}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <ItemsControl ItemsSource="{Binding Books}" IsVisible="{Binding HasBooks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="model:BookItem">
                                    <Button Classes="bookCard" Width="176" Margin="0,0,24,30"
                                            Command="{Binding DataContext.OpenBookCommand, ElementName=Root}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="11">
                                            <Border Height="242" CornerRadius="13" Background="{Binding CoverStart}"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Border Width="155" Height="285" Background="{Binding CoverEnd}"
                                                            Opacity=".36" HorizontalAlignment="Right"
                                                            RenderTransform="rotate(23deg)" />
                                                    <StackPanel Margin="18,25" VerticalAlignment="Center" Spacing="13">
                                                        <Border Height="1" Background="White" Opacity=".45" />
                                                        <TextBlock Text="{Binding CoverMark}" Foreground="White"
                                                                   FontFamily="Georgia" FontSize="48" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Category}" Foreground="White"
                                                                   Opacity=".75" FontSize="9" LetterSpacing="1"
                                                                   TextAlignment="Center" TextWrapping="Wrap" />
                                                        <Border Height="1" Background="White" Opacity=".45" />
                                                    </StackPanel>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="10" CornerRadius="8" Padding="7,4"
                                                            Background="#CCFFFFFF">
                                                        <TextBlock Text="{Binding Format}" FontSize="9" FontWeight="Bold" />
                                                    </Border>
                                                    <ProgressBar VerticalAlignment="Bottom" Height="5"
                                                                 Minimum="0" Maximum="1" Value="{Binding Progress}"
                                                                 Foreground="#FFF3DD" Background="#35FFFFFF" />
                                                </Grid>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                           MaxLines="2" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Author}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource MutedInkBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border IsVisible="{Binding IsLibraryEmpty}" MinHeight="230"
                                Background="{DynamicResource SurfaceBrush}" CornerRadius="18"
                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="⌕" FontSize="28" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource MutedInkBrush}" />
                                <TextBlock Text="Ничего не нашлось" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Попробуйте другой запрос или выберите все книги"
                                           FontSize="11" Foreground="{DynamicResource MutedInkBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
