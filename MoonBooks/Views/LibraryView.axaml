<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MoonBooks.ViewModels"
             xmlns:svc="using:MoonBooks.Services"
             xmlns:views="using:MoonBooks.Views"
             x:Class="MoonBooks.Views.LibraryView"
             x:Name="Root"
             x:DataType="vm:LibraryViewModel"
             DragDrop.AllowDrop="True">
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="32,28,32,48" Spacing="28" SizeChanged="Host_OnSizeChanged">
                <Grid ColumnDefinitions="*,280">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Библиотека" Classes="h1" />
                        <TextBlock Text="{Binding Summary}" Classes="caption" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Classes="search" PlaceholderText="Поиск" Text="{Binding SearchText}" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Добавить файлы" Command="{Binding ImportFilesCommand}" />
                    <Button Content="Добавить папку" Command="{Binding ImportFolderCommand}" />
                    <Button Content="Полки" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static svc:LibraryViewMode.Shelves}" />
                    <Button Content="Сетка" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static svc:LibraryViewMode.Grid}" />
                    <Button Content="Список" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static svc:LibraryViewMode.List}" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Classes="caption" />

                <StackPanel Spacing="12" IsVisible="{Binding ShowContinue}">
                    <TextBlock Text="Продолжить чтение" Classes="h2" />
                    <ItemsControl ItemsSource="{Binding ContinueReading}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BookCardViewModel">
                                <Button Command="{Binding OpenCommand}" Background="Transparent" Padding="0">
                                    <StackPanel Spacing="8" Width="148">
                                        <views:CoverView />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ProgressLabel}" Classes="caption" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="20" IsVisible="{Binding IsShelves}">
                    <ItemsControl ItemsSource="{Binding ShelfRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShelfRowViewModel">
                                <StackPanel Spacing="12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Name}" Classes="h2" />
                                        <Button Grid.Column="1" Content="Показать все" IsVisible="{Binding HasMore}"
                                                Command="{Binding #Root.((vm:LibraryViewModel)DataContext).ShowAllCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Books}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BookCardViewModel">
                                                <Button Margin="0,0,22,8" Padding="0" Background="Transparent" Command="{Binding OpenCommand}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Категории…" Command="{Binding CategoriesCommand}" />
                                                            <MenuItem Header="В избранное" Command="{Binding FavoriteCommand}" />
                                                            <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <StackPanel Width="148" Spacing="8">
                                                        <views:CoverView />
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Author}" Classes="caption" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Books}" IsVisible="{Binding IsGrid}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BookCardViewModel">
                            <Button Margin="0,0,22,20" Padding="0" Background="Transparent" Command="{Binding OpenCommand}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Категории…" Command="{Binding CategoriesCommand}" />
                                        <MenuItem Header="В избранное" Command="{Binding FavoriteCommand}" />
                                        <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Width="148" Spacing="8">
                                    <views:CoverView />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" MaxLines="2" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Author}" Classes="caption" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ListBox ItemsSource="{Binding Books}" IsVisible="{Binding IsList}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:BookCardViewModel">
                            <Grid ColumnDefinitions="54,*,120,70" Margin="0,6">
                                <Border Width="42" Height="60" CornerRadius="6" Background="{Binding PlaceholderBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Author}" Classes="caption" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding ProgressLabel}" VerticalAlignment="Center" Classes="caption" />
                                <TextBlock Grid.Column="3" Text="{Binding Format}" VerticalAlignment="Center" />
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Читать" Command="{Binding OpenCommand}" />
                                        <MenuItem Header="Категории…" Command="{Binding CategoriesCommand}" />
                                        <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel IsVisible="{Binding IsLibraryEmpty}" Spacing="12" HorizontalAlignment="Center" Margin="0,48">
                    <TextBlock Text="Библиотека пуста" Classes="h2" HorizontalAlignment="Center" />
                    <TextBlock Text="Добавьте FB2 или EPUB" Classes="caption" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Classes="primary" Content="Добавить файлы" Command="{Binding ImportFilesCommand}" />
                        <Button Content="Добавить папку" Command="{Binding ImportFolderCommand}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel IsVisible="{Binding IsSearchMiss}" Spacing="6" HorizontalAlignment="Center" Margin="0,32">
                    <TextBlock Text="Ничего не нашлось" Classes="h2" />
                    <TextBlock Text="Измените запрос или полку" Classes="caption" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border IsVisible="{Binding IsDropTarget}" Background="{DynamicResource SurfaceBrush}" Opacity="0.94" IsHitTestVisible="False">
            <TextBlock Text="Отпустите, чтобы добавить" Classes="h2" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
