<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MoonBooks.ViewModels"
             xmlns:svc="using:MoonBooks.Services"
             x:Class="MoonBooks.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="32,28" Spacing="28" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Настройки" Classes="h1" />
                <TextBlock Text="Библиотека, чтение и вид полок" Classes="caption" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Библиотека" Classes="h2" />
                <TextBox Text="{Binding LibraryPath}" PlaceholderText="Папка с книгами" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Обзор…" Click="BrowseLibrary_OnClick" />
                    <CheckBox Content="Перенести книги" IsChecked="{Binding MoveBooks}" VerticalAlignment="Center" />
                    <Button Classes="primary" Content="Сохранить папку" Command="{Binding ChangeLibraryCommand}" />
                </StackPanel>
                <CheckBox Content="Следить за папкой и добавлять новые файлы" IsChecked="{Binding WatchLibrary}" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Вид библиотеки" Classes="h2" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Полки" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static svc:LibraryViewMode.Shelves}" />
                    <Button Content="Сетка" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static svc:LibraryViewMode.Grid}" />
                    <Button Content="Список" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static svc:LibraryViewMode.List}" />
                </StackPanel>
                <TextBlock Classes="caption" Text="{Binding ViewMode}" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Чтение" Classes="h2" />
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Text="Шрифт" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding FontChoices}" SelectedItem="{Binding FontFamily}" HorizontalAlignment="Left" MinWidth="220" />

                    <TextBlock Grid.Row="1" Text="Размер" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="12" Maximum="32" Increment="1" Value="{Binding FontSize}" HorizontalAlignment="Left" Width="120" />

                    <TextBlock Grid.Row="2" Text="Интервал" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding LineSpacing}" HorizontalAlignment="Left" MinWidth="220">
                        <svc:LineSpacingPreset>Tight</svc:LineSpacingPreset>
                        <svc:LineSpacingPreset>Normal</svc:LineSpacingPreset>
                        <svc:LineSpacingPreset>Relaxed</svc:LineSpacingPreset>
                    </ComboBox>

                    <TextBlock Grid.Row="3" Text="Тема" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="3" Grid.Column="1" SelectedItem="{Binding Theme}" HorizontalAlignment="Left" MinWidth="220">
                        <svc:ReaderThemeKind>White</svc:ReaderThemeKind>
                        <svc:ReaderThemeKind>Sepia</svc:ReaderThemeKind>
                        <svc:ReaderThemeKind>Gray</svc:ReaderThemeKind>
                        <svc:ReaderThemeKind>Black</svc:ReaderThemeKind>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Text="Выравнивание" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding Alignment}" HorizontalAlignment="Left" MinWidth="220">
                        <svc:ReaderAlignment>Left</svc:ReaderAlignment>
                        <svc:ReaderAlignment>Justify</svc:ReaderAlignment>
                    </ComboBox>
                </Grid>
                <CheckBox Content="Переносы" IsChecked="{Binding Hyphenation}" />
                <CheckBox Content="Анимация смены страницы" IsChecked="{Binding PageAnimation}" />
                <CheckBox Content="Прокрутка вместо страниц" IsChecked="{Binding ScrollMode}" />
                <CheckBox Content="Бионическое чтение" IsChecked="{Binding Bionic}" />
                <Button Classes="primary" Content="Сохранить чтение" Command="{Binding SaveReaderCommand}" HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Синхронизация" Classes="h2" />
                <TextBlock Classes="caption" Text="{Binding SyncHint}" TextWrapping="Wrap" />
                <ComboBox SelectedItem="{Binding SyncProvider}" HorizontalAlignment="Left" MinWidth="220">
                    <svc:SyncProviderKind>None</svc:SyncProviderKind>
                    <svc:SyncProviderKind>WebDav</svc:SyncProviderKind>
                    <svc:SyncProviderKind>GoogleDrive</svc:SyncProviderKind>
                </ComboBox>
                <ComboBox SelectedItem="{Binding SyncMode}" HorizontalAlignment="Left" MinWidth="220">
                    <svc:SyncMode>ReadingStatus</svc:SyncMode>
                    <svc:SyncMode>StatusAndBooks</svc:SyncMode>
                </ComboBox>
                <TextBox Text="{Binding WebDavUrl}" PlaceholderText="Адрес WebDAV" />
                <TextBox Text="{Binding WebDavUser}" PlaceholderText="Логин WebDAV" />
                <TextBox Text="{Binding WebDavPassword}" PlaceholderText="Пароль WebDAV" PasswordChar="•" />
                <TextBox Text="{Binding GoogleClientId}" PlaceholderText="Google client id" />
                <TextBox Text="{Binding GoogleClientSecret}" PlaceholderText="Google client secret" PasswordChar="•" />
                <TextBox Text="{Binding GoogleDriveFolderId}" PlaceholderText="Id папки Google Drive" />
                <TextBox Text="{Binding BooksFolder}" PlaceholderText="Папка книг Moon+, по умолчанию Books" />
                <NumericUpDown Minimum="1" Maximum="180" Value="{Binding SyncInterval}" HorizontalAlignment="Left" Width="120" />
                <CheckBox Content="Автоматически принимать чужую позицию" IsChecked="{Binding AutoAccept}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Сохранить синхронизацию" Command="{Binding SaveSyncCommand}" />
                    <Button Content="Проверить соединение" Command="{Binding TestSyncCommand}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
