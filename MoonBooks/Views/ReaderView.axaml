<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MoonBooks.ViewModels"
             xmlns:views="using:MoonBooks.Views"
             xmlns:core="using:MoonBooks.Core.Content"
             xmlns:svc="using:MoonBooks.Services"
             x:Class="MoonBooks.Views.ReaderView"
             x:Name="Root"
             x:DataType="vm:ReaderViewModel"
             Background="{DynamicResource ReaderCanvasBrush}"
             Focusable="True">
    <Grid x:Name="Surface" SizeChanged="Host_OnSizeChanged"
          PointerMoved="Surface_OnPointerMoved"
          PointerPressed="Surface_OnPointerPressed"
          PointerWheelChanged="Surface_OnWheel">
        <ScrollViewer IsVisible="{Binding ScrollMode}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" Margin="32,72" Spacing="16">
                <TextBlock Text="{Binding ChapterTitle}" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource ReaderInkBrush}" />
                <ItemsControl ItemsSource="{Binding Content.Chapters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:ChapterContent">
                            <TextBlock Text="{Binding PlainText}" TextWrapping="Wrap" Foreground="{DynamicResource ReaderInkBrush}" FontSize="18" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="PageHost" IsVisible="{Binding !ScrollMode}" ColumnDefinitions="*,*" Margin="24,64,24,64">
            <views:PagePresenter x:Name="LeftPage" Grid.Column="0"
                                 Slice="{Binding LeftPage}"
                                 ReaderSettings="{Binding Settings}"
                                 Foreground="{DynamicResource ReaderInkBrush}"
                                 FootnoteInvoked="Page_OnFootnote" />
            <views:PagePresenter Grid.Column="1" IsVisible="{Binding Spread}"
                                 Slice="{Binding RightPage}"
                                 ReaderSettings="{Binding Settings}"
                                 FootnoteInvoked="Page_OnFootnote" />
        </Grid>

        <Border IsVisible="{Binding BarsVisible}" VerticalAlignment="Top" Height="56"
                Background="{DynamicResource ReaderPageBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,0">
                <Button Classes="icon" Content="←" Click="Back_OnClick" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button Classes="icon" Content="☰">
                        <Button.Flyout>
                            <Flyout>
                                <ScrollViewer MaxHeight="360" MinWidth="240">
                                    <ItemsControl ItemsSource="{Binding Toc}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:TocEntry">
                                                <Button Classes="nav" Content="{Binding Title}"
                                                        Command="{Binding #Root.((vm:ReaderViewModel)DataContext).SelectTocCommand}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="icon" Content="aA">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="8" MinWidth="220" Margin="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="A−" Command="{Binding DecreaseFontCommand}" />
                                        <Button Content="A+" Command="{Binding IncreaseFontCommand}" />
                                    </StackPanel>
                                    <Button Content="Интервал" Command="{Binding CycleSpacingCommand}" />
                                    <Button Content="Выравнивание" Command="{Binding CycleAlignmentCommand}" />
                                    <Button Content="Переносы" Command="{Binding ToggleHyphenationCommand}" />
                                    <Button Content="Бионика" Command="{Binding ToggleBionicCommand}" />
                                    <Button Content="Анимация" Command="{Binding ToggleAnimationCommand}" />
                                    <Button Content="Прокрутка" Command="{Binding ToggleScrollCommand}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="Белая" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:ReaderThemeKind.White}" />
                                        <Button Content="Сепия" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:ReaderThemeKind.Sepia}" />
                                        <Button Content="Серая" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:ReaderThemeKind.Gray}" />
                                        <Button Content="Ночь" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:ReaderThemeKind.Black}" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="icon" Content="♡" Command="{Binding ToggleBookmarkCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border IsVisible="{Binding BarsVisible}" VerticalAlignment="Bottom" Padding="24,10"
                Background="{DynamicResource ReaderPageBrush}">
            <Grid ColumnDefinitions="220,*,72" ColumnSpacing="12">
                <TextBlock Text="{Binding ChapterTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent}" />
                <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat={}{0:0}%}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <Border IsVisible="{Binding HasFootnote}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,72"
                MaxWidth="560" Padding="16" CornerRadius="12"
                Background="{DynamicResource ReaderPageBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Footnote}" TextWrapping="Wrap" />
                <Button Content="Закрыть" HorizontalAlignment="Right" Command="{Binding CloseFootnoteCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
