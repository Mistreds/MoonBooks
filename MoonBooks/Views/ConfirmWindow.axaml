<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoonBooks.Views.ConfirmWindow"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="MoonBooks">
    <StackPanel Margin="24" Spacing="14">
        <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Content="Отмена" Click="Cancel_OnClick" />
            <Button x:Name="ConfirmButton" Classes="primary" Content="Хорошо" Click="Confirm_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
