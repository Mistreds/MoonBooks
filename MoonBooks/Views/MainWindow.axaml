<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MoonBooks.ViewModels"
        x:Class="MoonBooks.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MoonBooks"
        Width="1280"
        Height="840"
        MinWidth="720"
        MinHeight="640"
        Background="{DynamicResource CanvasBrush}"
        WindowDecorations="None">
    <Grid RowDefinitions="48,*">
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_OnPointerPressed">
            <Grid ColumnDefinitions="*,Auto" Margin="16,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource AccentBrush}" />
                    <TextBlock Text="MOONBOOKS" FontSize="12" FontWeight="Bold" LetterSpacing="1.4" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Classes="icon" Content="—" Click="Minimize_OnClick" />
                    <Button Classes="icon" Content="□" Click="Maximize_OnClick" />
                    <Button Classes="icon" Content="×" Click="Close_OnClick" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="240,*">
            <Border Grid.Column="0" IsVisible="{Binding ShowSidebar}" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="16">
                    <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                        <TextBlock Text="{Binding SyncMessage}" Classes="caption" TextWrapping="Wrap" />
                        <Button Content="Синхронизировать" Command="{Binding SyncCommand}" HorizontalAlignment="Stretch" />
                        <Button Classes="nav" Content="Настройки" Command="{Binding ShowSettingsCommand}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Полки" Classes="caption" Margin="8,0,0,8" />
                        <Button Classes="nav" Content="Библиотека" Command="{Binding ShowLibraryCommand}" />
                        <ItemsControl ItemsSource="{Binding Library.Shelves}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShelfFilterViewModel">
                                    <Button Classes="nav"
                                            Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Library.SelectShelfCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="caption" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
