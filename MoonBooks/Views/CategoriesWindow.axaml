<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MoonBooks.Views.CategoriesWindow"
        x:CompileBindings="False"
        Title="Категории"
        Width="520"
        Height="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto">
        <TextBlock Text="Категории книги" FontSize="18" FontWeight="SemiBold" />
        <ListBox x:Name="CategoryList" Grid.Row="1" Margin="0,12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Assigned}" Click="Toggle_OnClick" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBox x:Name="NewName" PlaceholderText="Новая полка или новое имя" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Создать полку" Click="Create_OnClick" />
                <Button Content="Переименовать" Click="Rename_OnClick" />
                <Button Content="Удалить" Click="Delete_OnClick" />
            </StackPanel>
            <TextBlock Classes="caption" Text="Удаление полки не удаляет книги. Жанры можно объединить." TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="MergeKeep" Width="160" PlaceholderText="Оставить" />
                <ComboBox x:Name="MergeDrop" Width="160" PlaceholderText="Влить" />
                <Button Content="Объединить жанры" Click="Merge_OnClick" />
            </StackPanel>
        </StackPanel>
        <Button Grid.Row="3" Classes="primary" Content="Закрыть" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_OnClick" />
    </Grid>
</Window>
